# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- Base de données -------------------------------------------------------
POSTGRES_USER=fenuasmash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fenuasmash
# Port exposé sur la machine hôte (développement uniquement)
POSTGRES_PORT=5432

# --- Stack complète en local (docker compose --profile stack) -------------
API_PORT=8081
WEB_PORT=8080

# --- Production (docker-compose.prod.yml) ---------------------------------
# Registre et version des images publiées par la CD
IMAGE_PREFIX=ghcr.io/melfrom987/fenuasmash
IMAGE_TAG=latest
# Port HTTP public du serveur
HTTP_PORT=80
