# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- Base de données -------------------------------------------------------
POSTGRES_USER=fenuasmash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fenuasmash
# Port exposé sur la machine hôte (développement uniquement)
POSTGRES_PORT=5432

# --- API : connexion -------------------------------------------------------
# Secret qui signe les jetons de connexion (32 caractères minimum).
# En production, en générer un avec : openssl rand -base64 48
JWT_SECRET=change-me-local-jwt-secret-0123456789
# Premier compte admin, créé au démarrage tant qu'aucun admin n'existe.
# Il n'est jamais modifié ensuite (mot de passe : 12 caractères minimum).
ADMIN_EMAIL=admin@fenuasmash.local
ADMIN_PASSWORD=change-me-admin

# --- Stack complète en local (docker compose --profile stack) -------------
API_PORT=8081
WEB_PORT=8090

# --- Production (docker-compose.prod.yml) ---------------------------------
# Registre et version des images publiées par la CD
IMAGE_PREFIX=ghcr.io/melfrom987/fenuasmash
IMAGE_TAG=latest
# Port HTTP public du serveur
HTTP_PORT=80
